# Copy this file to .env and adjust values

# Model to load in the worker
MODEL_PATH=Qwen/Qwen3-TTS

# PyTorch device (worker only)
# cuda:0 for first GPU, cpu for CPU-only
DEVICE=cuda:0

# Model dtype: bfloat16 | float16 | float32
DTYPE=bfloat16

# Shared output directory (must match the volume mount)
OUTPUT_DIR=/data/tts_outputs

# API server port (host-side)
API_PORT=8000
