# Copy this file to .env and adjust values

# Model cho custom_voice + voice_design
MODEL_PATH_CUSTOM=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice

# Model cho voice_clone
MODEL_PATH_BASE=Qwen/Qwen3-TTS-12Hz-0.6B-Base

# PyTorch device (worker only)
DEVICE=cuda:0

# Model dtype: bfloat16 | float16 | float32
DTYPE=bfloat16

# Shared output directory (must match the volume mount)
OUTPUT_DIR=/data/tts_outputs

# API server port (host-side)
API_PORT=8000

# Public domain used by nginx and CORS.
PUBLIC_DOMAIN=speech.flashcutai.com
CORS_ORIGINS=https://speech.flashcutai.com,http://speech.flashcutai.com

# Shared secret required via X-API-Key header for /api/tts, /api/tasks,
# /api/voices, /api/presets. Leave empty to disable auth (local/dev only).
API_KEY=

# Optional: build frontend with the same key if API_KEY is enabled.
# This is visible to browser users, so do not treat it as strong auth.
VITE_API_KEY=

# Use ./nginx.https.conf after certificates exist in ./ssl.
NGINX_CONF=./nginx.conf
